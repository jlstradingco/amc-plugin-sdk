{
  "name": "@agent-mc/plugin-dev-shell",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/shell-window.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/shell.html','dist/shell.html')\"",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "start": "electron ./dist/shell-window.js"
  },
  "dependencies": {
    "@agent-mc/plugin-sdk": "workspace:^",
    "chokidar": "^4.0.0",
    "electron": "^39.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  }
}
