{
  "name": "@omniscio/plugin-cli",
  "version": "3.5.0",
  "description": "CLI tool for building Omniscio plugins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlstradingco/amc-plugin-sdk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://docs.omniscio.com/sdk/",
  "bugs": {
    "url": "https://github.com/jlstradingco/amc-plugin-sdk/issues"
  },
  "type": "module",
  "bin": {
    "omniscio-plugin": "./dist/index.js",
    "omniscio-automation": "./dist/automation-index.js",
    "amc-plugin": "./dist/index.js",
    "amc-automation": "./dist/automation-index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@omniscio/plugin-dev-shell": "workspace:^",
    "@omniscio/plugin-sdk": "workspace:^",
    "archiver": "^8.0.0",
    "chalk": "^5.4.0",
    "commander": "^12.0.0",
    "esbuild": "^0.28.2",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  }
}
