{
  "name": "@agent-mc/plugin-cli",
  "version": "1.3.0",
  "description": "CLI tool for building AMC plugins",
  "type": "module",
  "bin": {
    "amc-plugin": "./dist/index.js",
    "amc-automation": "./dist/automation-index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-mc/plugin-dev-shell": "workspace:^",
    "@agent-mc/plugin-sdk": "workspace:^",
    "archiver": "^8.0.0",
    "chalk": "^5.4.0",
    "commander": "^12.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  }
}
