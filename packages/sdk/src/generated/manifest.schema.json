{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omniscio plugin manifest",
  "description": "Generated from src/shared/plugin-manifest-schema.ts, the one schema every door reads. The properties mirror that schema; the allOf half carries the cross-field rules an editor cannot infer from them.",
  "type": "object",
  "properties": {
    "plugin": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "category": {
          "type": "string",
          "enum": [
            "planning",
            "development",
            "testing",
            "devops",
            "productivity",
            "other"
          ]
        },
        "sidebarGroup": {
          "type": "string",
          "enum": [
            "creative",
            "developer-tools-group",
            "ai-tools",
            "automation-group",
            "agent-tools",
            "productivity",
            "communication",
            "prompt-tools",
            "insights-group"
          ]
        },
        "license": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "free",
                "paid",
                "trial"
              ]
            }
          },
          "required": [
            "type"
          ]
        },
        "minAppVersion": {
          "type": "string",
          "maxLength": 50
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2048
          },
          "maxItems": 8
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "maxItems": 10
        },
        "links": {
          "type": "object",
          "properties": {
            "homepage": {
              "type": "string",
              "maxLength": 2048
            },
            "support": {
              "type": "string",
              "maxLength": 2048
            },
            "privacy": {
              "type": "string",
              "maxLength": 2048
            },
            "contact": {
              "type": "string",
              "maxLength": 2048
            },
            "repository": {
              "type": "string",
              "maxLength": 2048
            }
          }
        },
        "requiresOrganization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "win32",
              "darwin",
              "linux"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "author",
        "description",
        "icon",
        "category",
        "license"
      ]
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "type": {
            "type": "string",
            "enum": [
              "toggle",
              "select",
              "text",
              "number",
              "password"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "label"
              ]
            }
          },
          "optionsSource": {
            "type": "string",
            "enum": [
              "ai-engines"
            ]
          },
          "default": {},
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "agentWritable": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "label",
          "type"
        ]
      },
      "default": []
    },
    "storage": {
      "type": "object",
      "properties": {
        "collections": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "columns": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "text",
                    "integer",
                    "real",
                    "json"
                  ]
                }
              },
              "indexes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                }
              },
              "uniqueIndexes": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                  },
                  "minItems": 1
                }
              },
              "cliAccess": {
                "type": "string",
                "enum": [
                  "none",
                  "read",
                  "read-write"
                ]
              },
              "cliReadOnlyColumns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                },
                "maxItems": 64
              },
              "agentWritable": {
                "type": "boolean"
              },
              "agentReadable": {
                "type": "boolean"
              }
            },
            "required": [
              "columns"
            ]
          }
        },
        "kv": {
          "type": "object",
          "properties": {
            "agentWritable": {
              "type": "boolean"
            },
            "agentReadable": {
              "type": "boolean"
            },
            "agentHidden": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "maxItems": 64
            }
          }
        }
      },
      "required": [
        "collections"
      ],
      "default": {
        "collections": {}
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "entryPoint": {
          "type": "string"
        },
        "sidebar": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "icon": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            "newItem": {
              "type": "boolean"
            }
          },
          "required": [
            "title",
            "icon"
          ]
        },
        "overlay": {
          "type": "object",
          "properties": {
            "entryPoint": {
              "type": "string"
            }
          },
          "required": [
            "entryPoint"
          ]
        },
        "settingsPanel": {
          "type": "object",
          "properties": {
            "entryPoint": {
              "type": "string"
            }
          },
          "required": [
            "entryPoint"
          ]
        },
        "settingsSearch": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "maxItems": 10
              },
              "route": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "label",
              "route"
            ]
          },
          "maxItems": 20
        },
        "widget": {
          "type": "object",
          "properties": {
            "entryPoint": {
              "type": "string"
            }
          },
          "required": [
            "entryPoint"
          ]
        },
        "widgets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "kind": {
                "type": "string",
                "enum": [
                  "tile",
                  "panel"
                ]
              },
              "defaultSize": {
                "type": "object",
                "properties": {
                  "w": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "h": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40
                  }
                },
                "required": [
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              "faces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "stat",
                    "pill",
                    "dot",
                    "gauge",
                    "sparkline",
                    "list",
                    "chart",
                    "note",
                    "progress"
                  ]
                },
                "minItems": 1,
                "maxItems": 9
              }
            },
            "required": [
              "id",
              "title",
              "kind",
              "defaultSize"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 8
        },
        "windows": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "entryPoint": {
                "type": "string"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "width": {
                "type": "integer",
                "minimum": 200,
                "maximum": 10000
              },
              "height": {
                "type": "integer",
                "minimum": 200,
                "maximum": 10000
              }
            },
            "required": [
              "entryPoint"
            ]
          }
        },
        "hideProjectPanel": {
          "type": "boolean"
        },
        "hideSessionsPane": {
          "type": "boolean"
        },
        "nativePanel": {
          "type": "string",
          "enum": [
            "workspace-hub"
          ]
        },
        "presentation": {
          "type": "string",
          "enum": [
            "popup",
            "full"
          ]
        },
        "sessions": {
          "type": "object",
          "properties": {
            "contextTemplate": {
              "type": "string",
              "maxLength": 5000
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "showDivider": {
              "type": "boolean"
            },
            "realProjectContext": {
              "type": "boolean"
            },
            "perContext": {
              "type": "boolean"
            },
            "lockDown": {
              "type": "boolean"
            },
            "chatPlacement": {
              "type": "string",
              "enum": [
                "replace",
                "beside"
              ]
            },
            "sidePanel": {
              "type": "boolean"
            },
            "noContextText": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "suggestedPrompts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "label",
                  "prompt"
                ]
              },
              "maxItems": 4
            }
          }
        }
      }
    },
    "keybindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shortcut": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "commandId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "shortcut",
          "commandId",
          "label"
        ]
      },
      "maxItems": 20
    },
    "process": {
      "type": "object",
      "properties": {
        "allowedCommands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9._+-]+$"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "pinnedPrograms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9._+-]+$"
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "folder": {
                "type": "string",
                "enum": [
                  "data",
                  "install"
                ]
              },
              "platform": {
                "type": "string",
                "enum": [
                  "win32",
                  "darwin",
                  "linux"
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "marketplace"
                ]
              }
            },
            "required": [
              "name",
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10
        }
      }
    },
    "sdkVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "backend": {
      "type": "object",
      "properties": {
        "entryPoint": {
          "type": "string"
        },
        "resourceLimits": {
          "type": "object",
          "properties": {
            "memoryMb": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        },
        "timeouts": {
          "type": "object",
          "properties": {
            "activateMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "onEnableMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "onDisableMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "onShutdownMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "onSettingsChangedMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "onAppReadyMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "cliDispatchMs": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        }
      },
      "required": [
        "entryPoint"
      ]
    },
    "sessionTools": {
      "type": "boolean"
    },
    "linkClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "host",
          "path"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    },
    "uploadHosts": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
      },
      "minItems": 1,
      "maxItems": 10
    },
    "cli": {
      "type": "object",
      "properties": {
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "DELETE",
                  "PATCH"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "auth": {
                "type": "boolean"
              },
              "requiresConfirmation": {
                "type": "boolean"
              },
              "safe": {
                "type": "boolean"
              },
              "preview": {
                "type": "string",
                "enum": [
                  "two-step",
                  "card"
                ]
              },
              "previewPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "agentReadable": {
                "type": "boolean"
              }
            },
            "required": [
              "method",
              "path"
            ]
          },
          "maxItems": 200
        }
      },
      "required": [
        "endpoints"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "storage",
          "secrets",
          "sessions",
          "ai",
          "ai.subscription",
          "ai.images",
          "tts",
          "stt",
          "microphone",
          "network",
          "network.upload",
          "cron",
          "cli",
          "notifications",
          "system",
          "rss",
          "auth",
          "auth.session",
          "auth.sharedSignIn",
          "auth.actAsUser",
          "sessions.readHistory",
          "sessions.images",
          "boards.read",
          "boards.link",
          "boards.write",
          "tasks.read",
          "tasks.write",
          "sessions.launchAny",
          "sessions.observeStatus",
          "sessions.control",
          "vault.read",
          "vault.write",
          "calendar.read",
          "timeTracker.read",
          "timeTracker.write",
          "calendar.write",
          "teamChat.read",
          "teamChat.write",
          "inbox",
          "inbox.read",
          "navigation",
          "chrome",
          "chrome.widget",
          "launch",
          "firebase",
          "recording",
          "spend",
          "coreRead",
          "oauth",
          "channel",
          "workspace.read",
          "workspace.write",
          "workspace.exec",
          "documents.read",
          "itemFolders",
          "documents.write",
          "members.read",
          "people.read",
          "coaching-profile",
          "brands",
          "teamChat.emoji",
          "email.send",
          "limits",
          "webassembly",
          "email.fromName",
          "live"
        ]
      },
      "maxItems": 66
    },
    "mobile": {
      "type": "boolean"
    },
    "usageActions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,40}$"
      },
      "maxItems": 20
    },
    "uiAnchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": [
              "button",
              "link",
              "input",
              "toggle",
              "tab",
              "menuitem",
              "row",
              "region",
              "composite",
              "dialog",
              "panel",
              "display",
              "select",
              "form"
            ]
          },
          "when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "kind"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "uiAnchorsExtra": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "kind": {
            "type": "string",
            "enum": [
              "button",
              "link",
              "input",
              "toggle",
              "tab",
              "menuitem",
              "row",
              "region",
              "composite",
              "dialog",
              "panel",
              "display",
              "select",
              "form"
            ]
          },
          "when": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "kind"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "business": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 1
        },
        "namespace": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "requires": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 12,
            "pattern": "^[1-9][0-9]*$"
          }
        },
        "provides": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 12,
            "pattern": "^[1-9][0-9]*$"
          }
        },
        "requests": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
