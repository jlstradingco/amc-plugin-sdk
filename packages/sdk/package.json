{
  "name": "@agent-mc/plugin-sdk",
  "version": "1.0.0",
  "description": "SDK for building Agent Mission Control plugins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/types/bridge.d.ts",
      "import": "./dist/types/bridge.js",
      "require": "./dist/cjs/types/bridge.js",
      "default": "./dist/types/bridge.js"
    },
    "./validators": {
      "types": "./dist/validators/manifest.d.ts",
      "import": "./dist/validators/manifest.js",
      "require": "./dist/cjs/validators/manifest.js",
      "default": "./dist/validators/manifest.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}))\"",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
